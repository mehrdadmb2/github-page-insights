{
  "name": "github-page-insights-universal",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/preflight.mjs",
    "check:worker": "node --check worker/index.js",
    "check:dashboard": "node --check docs/app.js && node --check docs/analytics.js && node --check docs/config.js",
    "check:contract": "node scripts/validate-schema.mjs",
    "wrangler:version": "wrangler --version",
    "cf:login": "wrangler login --use-keyring",
    "cf:whoami": "wrangler whoami",
    "d1:list": "wrangler d1 list",
    "d1:info": "wrangler d1 info github-page-insights --json",
    "d1:setup": "wrangler d1 execute github-page-insights --remote --file=./db/UNIVERSAL-EVENT-INSIGHTS-D1-ONE-SHOT-V9.1.sql --yes",
    "d1:verify": "wrangler d1 execute github-page-insights --remote --command=\"SELECT key,value FROM schema_meta ORDER BY key;\"",
    "d1:backup": "wrangler d1 export github-page-insights --remote --output=./backups/d1-backup.sql",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "tail": "wrangler tail github-page-insights-worker",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
